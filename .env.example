# =============================================================================
# AIFitnessSummary — Environment Configuration
# Copy this file to .env and fill in your credentials.
# The .env file is gitignored and will never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Garmin Connect credentials
# Used to pull all health and activity metrics from Garmin Connect.
# These are the same email and password you use to log in at connect.garmin.com.
# On first run you will be prompted for a 6-digit MFA code sent to this email.
# After that, OAuth tokens are cached in ~/.garminconnect for ~1 year.
# -----------------------------------------------------------------------------
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=yourpassword

# -----------------------------------------------------------------------------
# Hevy API key
# Required to fetch strength training workouts from the Hevy app.
# A Hevy Pro subscription is required for API access.
# Generate your key at: https://hevy.com/settings?developer
# -----------------------------------------------------------------------------
HEVY_API_KEY=your_hevy_api_key

# -----------------------------------------------------------------------------
# Anthropic API key
# Used to call Claude for narrative analysis and goal parsing.
# Generate your key at: https://platform.claude.com/settings/keys
# The model used is claude-sonnet-4-6 (configurable in config.py).
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key

# -----------------------------------------------------------------------------
# Email delivery (Gmail SMTP)
# Reports are converted to styled HTML and sent via Gmail SMTP (SSL, port 465).
# All three variables must be set for email to be enabled. If any are missing,
# email is silently skipped and reports are still written to disk.
#
# EMAIL_SENDER    : The Gmail address that sends the report. Must be the same
#                   account that owns the App Password below.
# EMAIL_RECIPIENT : The address that receives the report. Can be the same as
#                   EMAIL_SENDER if you want to email yourself.
# GMAIL_APP_PASSWORD : A 16-character App Password from your Google Account.
#
# To generate a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already active.
#   3. Search for "App Passwords" or visit https://myaccount.google.com/apppasswords
#   4. Create a new app password (name it e.g. "AIFitnessSummary").
#   5. Copy the displayed 16-character code (shown once) and paste it below.
#      Spaces in the displayed password are cosmetic — include or omit them.
# -----------------------------------------------------------------------------
EMAIL_SENDER=you@gmail.com
EMAIL_RECIPIENT=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# -----------------------------------------------------------------------------
# Google Fit (optional — for Eufy / smart scale weight data)
#
# If you use a smart scale (e.g. Eufy) that syncs to Google Fit, set these
# to pull daily weight readings into your fitness report automatically.
#
# To set up:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID (type: Desktop app)
#   3. Enable the "Fitness API" under APIs & Services → Library
#   4. Copy the client ID and secret below
#
# On first run you'll be prompted to open a browser URL and paste an auth code.
# After that, a refresh token is cached at ~/.googlefit_token.json.
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret

# -----------------------------------------------------------------------------
# Database configuration (optional)
#
# Option 1 — Supabase / PostgreSQL (recommended for GitHub Actions):
#   Set DATABASE_URL to your Supabase connection string. Find it in the
#   Supabase dashboard under Settings → Database → Connection string (URI).
#   Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Option 2 — SQLite (default for local development):
#   Leave DATABASE_URL unset. The app uses a local file (fitness_memory.db).
#   Optionally override the path with DB_PATH.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DB_PATH=/path/to/fitness_memory.db
