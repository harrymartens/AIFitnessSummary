# =============================================================================
# AIFitnessSummary — Health & Performance Digest System
# Copy this file to .env and fill in your credentials.
# The .env file is gitignored and will never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Garmin Connect credentials
# Used to pull health and activity metrics from Garmin Connect.
# On first run you will be prompted for a 6-digit MFA code sent to this email.
# After that, OAuth tokens are cached in ~/.garminconnect for ~1 year.
# -----------------------------------------------------------------------------
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=yourpassword

# -----------------------------------------------------------------------------
# Hevy API key
# Required to fetch strength training workouts from the Hevy app.
# A Hevy Pro subscription is required for API access.
# Generate your key at: https://hevy.com/settings?developer
# -----------------------------------------------------------------------------
HEVY_API_KEY=your_hevy_api_key

# -----------------------------------------------------------------------------
# Anthropic API key
# Used to call Claude for AI digest generation.
# Generate your key at: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key

# -----------------------------------------------------------------------------
# Email delivery (Gmail SMTP)
# Reports are converted to styled HTML and sent via Gmail SMTP (SSL, port 465).
# All three variables must be set for email to be enabled.
# -----------------------------------------------------------------------------
EMAIL_SENDER=you@gmail.com
EMAIL_RECIPIENT=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# -----------------------------------------------------------------------------
# Training plan (optional — defaults to training_plan.md in project root)
# Path to the structured markdown training plan file.
# -----------------------------------------------------------------------------
# TRAINING_PLAN_PATH=/path/to/training_plan.md

# -----------------------------------------------------------------------------
# Nutrition & weight data (Apple Health / MacroFactor)
#
# MacroFactor syncs calories, protein, and expenditure to Apple Health.
# Set ONE of these to import weight + nutrition data.
#
# File-based: iOS Shortcut writes JSON to a synced file.
# Webhook-based: iOS Shortcut POSTs data to a webhook URL.
#
# Expected JSON format:
# [{"date":"2026-03-01", "weight_kg":82.5, "calories":2850, "protein_g":185}, ...]
# -----------------------------------------------------------------------------
# APPLE_HEALTH_WEIGHT_FILE=~/Library/Mobile Documents/com~apple~CloudDocs/health_data.json
# APPLE_HEALTH_WEIGHT_URL=https://your-webhook-endpoint.com/health

# -----------------------------------------------------------------------------
# Database (optional)
# PostgreSQL (Supabase) for GitHub Actions, or SQLite (default) for local.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DB_PATH=/path/to/fitness_memory.db
